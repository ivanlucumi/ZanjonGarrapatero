<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Proteger archivos sensibles si el DocumentRoot apunta a la raíz del proyecto
    RewriteRule ^(\.env|\.git|composer\.json|composer\.lock|artisan|phpunit\.xml|package\.json) - [F,L,NC]

    # Reenviar todas las peticiones hacia la carpeta public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
